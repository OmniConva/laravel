{
    "name": "omniconva/laravel",
    "description": "Connect a Laravel store to OmniConva: product sync, AI chat orders and webhooks in a few lines.",
    "keywords": [
        "omniconva",
        "laravel",
        "ai",
        "chat",
        "ecommerce",
        "webhooks",
        "sales agent"
    ],
    "homepage": "https://omniconva.com/docs/custom-website-api",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "OmniConva",
            "email": "contact@omniconva.com",
            "homepage": "https://omniconva.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/bus": "^12.0 || ^13.0",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/queue": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/view": "^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.0 || ^4.0",
        "laravel/pint": "^1.18"
    },
    "autoload": {
        "psr-4": {
            "OmniConva\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OmniConva\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OmniConva\\Laravel\\OmniConvaServiceProvider"
            ],
            "aliases": {
                "OmniConva": "OmniConva\\Laravel\\Facades\\OmniConva"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
